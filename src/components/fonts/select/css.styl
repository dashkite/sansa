main

  // - TODO remove this after posh reboot
  // - we shouldn't need it because custom
  // - inputs should be laid out like any
  // - other field...
  margin-block 1rem
  gap 2rem

  & > .pins
    display flex
    flex-flow column
    gap 1rem

    & > div
      display grid
      gap 0.25rem
      align-items baseline
      grid-template-columns repeat(auto-fit, minmax(4rem, 1fr))
    
      :first-child
        justify-self end

      :last-child
        justify-self center

  & > .filters
    display flex
    flex-flow column
    gap 1rem

    & > div
      display flex
      flex-flow column
      gap 0.5rem
      
button
  font-size var(--smaller-copy-font-size)
  background var(--background)
  color var(--highlight)
  min-width 4rem
  padding-block 0.25rem