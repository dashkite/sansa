wheel-gradient()
  stops = ()
  push(stops, oklch(66.66% .1 x)) for x in (0..360)
  "linear-gradient(in oklch to right, %s)" % unquote(join(", ", stops))

main

  //- TODO remove this after posh reboot
  //- we shouldn't need it because custom
  //- inputs should be laid out like any
  //- other field...
  
  // margin-block 1rem
  gap 1rem

vellum-field[name="color"]
  [slot="input"]
    display flex
    gap 1rem
    align-items center

    input[type="range"]
      &::-webkit-slider-runnable-track
        height 0.5rem
        background wheel-gradient()

      &::-moz-range-track
        height 0.5rem
        background wheel-gradient()

      &::-webkit-slider-thumb
        background transparent
        height 1rem
        border 1px solid var(--accent)

      &::-moz-range-thumb
        background transparent
        height 1rem
        border 1px solid var(--accent)

sansa-select-image
  &::part(L1)
    display none


//- TODO we need a small button class or something...
